{
  "name": "practice-timer-desktop",
  "productName": "Practice Timer",
  "version": "0.1.5",
  "description": "Personal Practice Timer desktop app",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.mjs desktop/storage.test.mjs desktop/native-sounds.test.mjs",
    "test:desktop": "node --test desktop/e2e.test.mjs",
    "test:release": "node --test desktop/release.test.mjs",
    "build": "node desktop/build.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "45.3.2",
    "playwright-core": "1.65.0"
  }
}
